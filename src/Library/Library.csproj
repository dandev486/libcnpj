<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LibCnpj</RootNamespace>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>libcnpj</PackageId>
    <PackageVersion>0.3.2</PackageVersion>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/dandev486/libcnpj/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dandev486/libcnpj/</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>Daniel Augusto</Authors>
    <Company>dandev486</Company>
    <PackageTags>libcnpj</PackageTags>
    <Description>
      LibCnpj, a simple library for validating Brazil's CNPJ.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE" Pack="true" PackagePath="">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\README.md" Pack="true" PackagePath="">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
